{
  "name": "myappsweb-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "MyAppsWeb - App Showcase and Download Platform with Admin Management",
  "scripts": {
    "postinstall": "cd server && npm install && cd ../client && npm install",
    "install:server": "cd server && npm install",
    "install:client": "cd client && npm install",
    "install:all": "npm run install:server && npm run install:client",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "build:client": "cd client && npm run build",
    "build": "cd client && npm run build",
    "start": "cd server && npm start"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "googleapis": "^144.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1"
  },
  "engines": {
    "node": "22.x"
  },
  "keywords": [
    "app-store",
    "app-distribution",
    "admin-dashboard",
    "apk-downloads",
    "windows-apps"
  ],
  "author": "",
  "license": "ISC"
}
